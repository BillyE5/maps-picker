{
  "manifest_version": 3,
  "name": "Maps Picker - 反白找地圖",
  "version": "1.2.0",
  "description": "反白影片說明、網頁上的地址或店名，一鍵在 Google Maps 開啟或複製。\n熱鍵:(option + Shift + X)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Maps Picker 清單"
  },
  "commands": {
    "open-selection": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "用 Google Maps 搜尋反白文字"
    },
    "save-selection": {
      "description": "把反白文字存進清單（需先在彈出視窗啟用待存清單）"
    },
    "ocr-region": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "框選畫面文字辨識"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}